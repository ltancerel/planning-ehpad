# Modèle de configuration pour lancer la campagne de non-régression e2e
# contre un déploiement déjà en ligne (STAGING), depuis un serveur externe.
#
# Copier ce fichier en ".env.e2e" (jamais committé, cf. .gitignore) et
# remplir les valeurs réelles. Voir docs/non-regression-serveur.md pour le
# détail de l'installation et du lancement.

# URL du déploiement Vercel Preview qui suit la branche "staging".
PLAYWRIGHT_BASE_URL=https://<url-du-déploiement-staging>.vercel.app

# Administrateur d'EHPAD — compte réel, mot de passe réel de PROD conservé
# sur STAGING. Ne jamais committer la vraie valeur.
E2E_ADMIN_EMAIL=direction@lesjardinsderambam.fr
E2E_ADMIN_PASSWORD=

# Manager (IDEC) — compte de test STAGING, mot de passe de test.
E2E_MANAGER_EMAIL=idec@lesjardinsderambam.fr
E2E_MANAGER_PASSWORD=

# Utilisateur (Accueil) — compte de test STAGING, mot de passe de test.
E2E_USER_EMAIL=accueil@lesjardinsderambam.fr
E2E_USER_PASSWORD=
